{
  "name": "energy-sim",
  "version": "0.0.0",
  "private": true,
  "description": "Compare whole-house energy setups for a home in England, with cost, carbon and payback as honest ranges.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark:rough": "tsx scripts/benchmark-rough.ts",
    "benchmark:hem-input": "tsx scripts/benchmark-hem-input.ts",
    "benchmark:tables": "tsx scripts/benchmark-tables.ts",
    "fetch:pvgis": "tsx scripts/fetch-pvgis.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "archetypes": "tsx scripts/archetypes.ts",
    "report": "tsx scripts/report.ts",
    "bench": "tsx scripts/bench.ts",
    "derive:base-profile": "tsx scripts/derive-base-profile.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
